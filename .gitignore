# Downloaded team crests -- other people's trademarks, and re-fetchable with get-logos.ps1
fairy.casterfx/logos/

# Written by the camera script, consumed by get-logos.ps1 -Watch
fairy.casterfx/wanted.json

# ODC team index cache
.odc-teams-cache.json

# Tooling state
.claude-flow/

# Downloaded analyzer binaries, fetched on demand by check.ps1
tools/

# Empty files some other tool keeps dropping in the working directory, named after
# whatever numeric value it redirected ("0", "900", "0.999"). Anchored so that real
# assets with digit-leading names, like logos/0RB.png, are unaffected.
/[0-9]*
/fairy.casterfx/[0-9]*
